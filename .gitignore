# Minimal deployment repository: local review material stays off GitHub.
/*
!/.gitignore
!/.dockerignore
!/Dockerfile
!/backend/
!/frontend/
!/demo/
!/deploy/
/backend/*
!/backend/app/
!/backend/requirements.lock
/frontend/*
!/frontend/index.html
!/frontend/app.js
!/frontend/style.css
/deploy/*
!/deploy/render-persistent.yaml
!/deploy/render-free-postgres.yaml

# Submission review: only the explicitly intended public Markdown documents.
!/README.md
!/ARCHITECTURE.md
!/docs/
/docs/*
!/docs/ai-build-history/
/docs/ai-build-history/*
!/docs/ai-build-history/README.md
