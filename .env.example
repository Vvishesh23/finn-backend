# Nonsecret placeholders only. FINN never loads .env files automatically.
AI_ENABLED=false
REASONING_PROVIDER=disabled
GEMINI_API_KEY=REPLACE_ME_IN_HOST_SECRET_MANAGER
GEMINI_REASON_MODEL=gemini-3.5-flash-lite
AI_BUDGET_STORAGE_PERSISTENT=false
# Owner must mount persistent storage before setting this true for Gemini.
# FINN_DB=/app/data/finn.sqlite3
MAX_AI_REQUESTS_PER_DAY=100
MAX_AI_REQUESTS_PER_MINUTE_GLOBAL=6
MAX_AI_REQUESTS_PER_CLIENT_DAY=20
MAX_AI_REQUESTS_PER_CLIENT_MINUTE=6
MAX_AI_CONCURRENT=2
AI_GLOBAL_BUDGET_TOKENS_PER_DAY=100000
MAX_INPUT_TOKENS=16000
MAX_EVIDENCE_CHARS=12000
MAX_ANSWER_TOKENS=800
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=0
MAX_REQUEST_BODY_BYTES=8192
MAX_QUERY_CHARS=2000
MAX_REQUESTS_PER_CLIENT_MINUTE=30
# Empty means no forwarding header is trusted. Never use a wildcard.
TRUSTED_PROXY_CIDRS=
